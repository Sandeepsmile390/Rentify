# Rentify — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ── Supabase ─────────────────────────────────────────────────────
# Your Supabase project URL (visible in project settings — safe to share)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Your Supabase anon public key (NOT the service-role key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER

# ── Build info (populated by CI) ─────────────────────────────────
APP_VERSION=1.0.0
BUILD_NUMBER=1

# ── Usage ────────────────────────────────────────────────────────
# Web dev:
#   flutter run -d chrome --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Android debug:
#   flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Android release APK:
#   flutter build apk --release --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Web release build:
#   flutter build web --release --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
